; Engine configuration file.
config_version=5

[application]

config/name="Tainted"
run/main_scene="res://scenes/character_select.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/icon/icon.png"

[autoload]

Updater="*res://scripts/updater.gd"
LootGenerator="*res://scripts/loot_generator.gd"
GameState="*res://scripts/game_state.gd"
Net="*res://scripts/net.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[tainted]

net/world_name="Tainted World"
net/world_addresses=PackedStringArray("wss://tainted.xandflix.uk", "ws://192.168.86.18:24601")
net/auth_url="https://auth.xandflix.uk"

[gui]

theme/custom_font="res://assets/fonts/body.tres"

[importer_defaults]

texture={
"mipmaps/generate": true
}

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.09, 1)
